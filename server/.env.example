DATABASE_URL=postgres://open_assistant:open_assistant@localhost:5434/open_assistant
PORT=8787

# Gmail SMTP: use an app password (Google Account → Security → App passwords).
# Leave SMTP_USER empty to print sign-in codes to the server log instead of emailing them.
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Open Assistant <you@gmail.com>"

# Google Cloud Console → Credentials → OAuth client ID → "Desktop app".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI API key for agent replies (https://platform.openai.com/api-keys).
OPENAI_API_KEY=
# Optional: the model agents use (defaults to gpt-6-luna).
OPENAI_MODEL=
