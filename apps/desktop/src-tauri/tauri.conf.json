{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Open Assistant",
  "version": "0.1.0",
  "identifier": "org.openassistant.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @open-assistant/web dev",
    "beforeBuildCommand": "pnpm --filter @open-assistant/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Open Assistant",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 480,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
