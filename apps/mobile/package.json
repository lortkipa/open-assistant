{
  "name": "@open-assistant/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "dev:android": "node scripts/android.js run",
    "dev:ios": "expo run:ios",
    "build:android": "node scripts/android.js build",
    "build:ios": "expo prebuild --platform ios && xcodebuild -workspace ios/OpenAssistant.xcworkspace -scheme OpenAssistant -configuration Release -archivePath dist/OpenAssistant.xcarchive archive",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/schibsted-grotesk": "^0.4.2",
    "@open-assistant/shared": "workspace:*",
    "expo": "~57.0.28",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
